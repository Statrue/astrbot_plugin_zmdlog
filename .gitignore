# Local planning docs (design drafts, upstream API proposals); superseded
# ones live in docs/archive/. Only the agent-skill config (docs/agents/) and
# the ADRs (docs/adr/) are committed.
/docs/*
!/docs/agents/
!/docs/adr/

# Local IDE metadata
/.idea/

# Python bytecode
__pycache__/
*.pyc

# AstrBot data dir created when driving main.py locally
/data/

# Tool caches and local environments
/.venv/
/venv/
/.ruff_cache/
/.pytest_cache/
/.claude/
